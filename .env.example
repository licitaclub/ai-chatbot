# Get your Google Gemini API Key here https://cloud.google.com/vertex-ai
GOOGLE_GENERATIVE_AI_API_KEY=****

# Ticket for Mercado Público API (Chilean public procurement).
# Get yours at https://api.mercadopublico.cl
MERCADO_PUBLICO_TICKET=****

# NextAuth URL (used for authentication callbacks)
NEXTAUTH_URL=http://localhost:3000

# Generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

/*
 * The following keys below are automatically created and
 * added to your environment when you deploy on vercel
 */

# Instructions to create kv database here: https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# Neon database connection (pooled, for runtime queries)
# Get this from your Neon project dashboard → Connection Strings → Object
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Neon database connection (unpooled, for Drizzle migrations only)
# Use the "Direct" connection string, not the "Pool" one
DATABASE_URL_UNPOOLED=postgresql://user:password@host:5432/dbname?sslmode=require

# Admin panel Supabase connection (Procurement Intelligence)
# This connects to the admin.licitaclub.cl Supabase project
ADMIN_SUPABASE_URL=https://iahkmnrneqvyqqnbyagp.supabase.co
ADMIN_SUPABASE_KEY=****
